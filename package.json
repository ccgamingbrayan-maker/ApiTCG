{
  "name": "one-piece-tcg-api",
  "version": "1.0.0",
  "description": "One Piece TCG price tracker API with TCGPlayer scraping and Supabase storage",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "seed": "tsx src/scripts/seedAPI.ts",
    "sync-sim": "tsx src/scripts/syncFromSim.ts",
    "clean": "tsx src/scripts/cleanMissing.ts",
    "clean-small": "tsx src/scripts/cleanSmall.ts",
    "normalize": "tsx src/scripts/normalizeSets.ts",
    "update-rarities": "tsx src/scripts/updateHighRarities.ts",
    "seed-variants": "tsx src/scripts/seedAllVariants.ts",
    "build:css": "tailwindcss -i src/input.css -o public/style.css --minify",
    "watch:css": "tailwindcss -i src/input.css -o public/style.css --watch",
    "postinstall": "npx playwright install chromium || true"
  },
  "keywords": [
    "tcg",
    "one-piece",
    "price-tracker"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@google/genai": "^2.27.0",
    "@supabase/supabase-js": "^2.117.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.5",
    "express": "^4.22.3",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.6.4",
    "nodemon": "^3.1.14",
    "tailwindcss": "^4.3.3",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
